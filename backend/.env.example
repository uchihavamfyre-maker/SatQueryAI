# SatQuery AI — Backend Environment Configuration
# Copy this file to .env and adjust values for your setup.

# Device: "cuda" for GPU, "cpu" for CPU-only
DEFAULT_DEVICE=cpu

# LLM orchestrator model (HuggingFace model ID or local path)
# Mistral-7B-Instruct requires ~6GB VRAM with 4-bit quantization
ORCHESTRATOR_MODEL=mistralai/Mistral-7B-Instruct-v0.2
ORCHESTRATOR_LOAD_IN_4BIT=true
ORCHESTRATOR_DEVICE=auto

# Tile size for large image processing (pixels)
TILE_SIZE=512
TILE_OVERLAP=64

# Map-click imagery uses public Earth Search Sentinel-2 COGs (no credentials).
# The backend reads only a 512x512 crop around each clicked location.
IMAGERY_STAC_URL=https://earth-search.aws.element84.com/v1/search
IMAGERY_COLLECTION=sentinel-2-l2a
IMAGERY_DAYS_BACK=180
IMAGERY_MAX_CLOUD_COVER=30
IMAGERY_TILE_SIZE=512

# Max upload size in bytes (default 500 MB)
MAX_IMAGE_BYTES=524288000

# Writable runtime data directory. Free hosts may use ephemeral storage.
DATA_DIR=./data

# CORS — set your deployed frontend origins as a JSON list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost","https://localhost","capacitor://localhost"]

# Database (SQLite for MVP; swap to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite+aiosqlite:///./data/satquery.db

# --- Optional model backends ---
# Keep baseline mode unless the checkpoint and license are available.
RSVQA_BACKEND=baseline
RSVQA_MODEL_ID=google/paligemma-3b-ft-rsvqa-hr-224
# Set HF_TOKEN after accepting the Google/PaliGemma license on Hugging Face.
# HF_TOKEN=hf_...

ENABLE_HEAVY_MODELS=false
MAX_CONCURRENT_JOBS=1
# Public deployments should set an API key and explicit CORS origins.
# API_KEY=replace-with-a-secret
HOST=0.0.0.0
PORT=8000
